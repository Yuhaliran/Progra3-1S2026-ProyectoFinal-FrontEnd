@model Progra3.ProyectoFinal.Frontend.Util.ListaCircularDoble<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>

@{
    ViewData["Title"] = "Principal";
    var libros = Model?.ObtenerListaCompleta() ?? new List<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>();
}



<div class="container my-5 contenido-principal">
    
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <form asp-controller="Home" asp-action="Buscar" method="get">
                <div class="input-group shadow-lg" style="border-radius: 30px; overflow: hidden; border: 1px solid var(--color-borde);">
                    <input type="text" name="query" class="form-control px-4 py-3 border-0 text-white" 
                           placeholder="Buscar por Título, Autor o ISBN..." 
                           style="background-color: var(--fondo-secundario) !important; color: var(--texto-principal) !important; font-size: 1.05rem;"
                           required />
                    <button type="submit" class="btn btn-primary px-4 d-flex align-items-center justify-content-center" 
                            style="background-color: var(--acento-principal) !important; border: none; font-size: 1.25rem;">
                        🔍
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (libros.Count == 0)
    {
        <div class="text-center py-5 card shadow-sm p-5 border-0 rounded-4" style="background-color: var(--fondo-secundario);">
            <h2 class="display-6 fw-bold text-danger">Bienvenido a Xandria</h2>
            <p class="lead my-3 text-muted">No hay libros registrados en el sistema en este momento.</p>
            <div class="my-4">
                <span style="font-size: 5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.25));">📚</span>
            </div>
            <p class="text-secondary max-width-500 mx-auto">Por favor, registra algunos libros en el panel de administración para comenzar a disfrutar de la lectura.</p>
        </div>
    }
    else
    {
        <div class="carrusel-contenedor">
            <span class="carrusel-subtitulo">Libritos </span>
            
            <div class="carrusel-vista mt-4">
                <button class="carrusel-control anterior" id="btn-carrusel-prev" title="Anterior">
                    &lt;
                </button>
                
                <div class="carrusel-lista" id="carrusel-lista-libros">
                    @for (int i = 0; i < libros.Count; i++)
                    {
                        var libro = libros[i];
                        var imageSrc = "";
                        if (!string.IsNullOrEmpty(libro.Portada))
                        {
                            if (libro.Portada.StartsWith("http") || libro.Portada.StartsWith("/") || libro.Portada.StartsWith("~"))
                            {
                                imageSrc = libro.Portada;
                            }
                            else if (libro.Portada.Contains("base64,"))
                            {
                                imageSrc = libro.Portada;
                            }
                            else
                            {
                                imageSrc = "data:image/jpeg;base64," + libro.Portada;
                            }
                        }
                        else
                        {
                            imageSrc = "/images/Home-book.webp";
                        }

                        <div class="libro-item" 
                             data-index="@i"
                             data-titulo="@libro.Titulo"
                             data-autor="@libro.Autor"
                             data-isbn="@libro.ISBN"
                             onclick="window.location.href='@Url.Action("DetallesLibro", "Home", new { isbn = libro.ISBN })'"
                             style="cursor: pointer;">
                            <img src="@imageSrc" alt="@libro.Titulo" onerror="this.src='/images/Home-book.webp';">
                        </div>
                    }
                </div>
                
                <button class="carrusel-control siguiente" id="btn-carrusel-next" title="Siguiente">
                    &gt;
                </button>
            </div>
            
            <div class="libro-info-panel">
                <div class="libro-info-titulo" id="carrusel-info-titulo"></div>
                <div class="libro-info-autor" id="carrusel-info-autor"></div>
                <div class="libro-info-isbn" id="carrusel-info-isbn"></div>
            </div>
        </div>
    }
</div>
