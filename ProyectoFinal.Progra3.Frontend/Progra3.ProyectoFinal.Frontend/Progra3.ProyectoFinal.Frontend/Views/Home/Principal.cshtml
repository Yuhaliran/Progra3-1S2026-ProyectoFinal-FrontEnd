@model Progra3.ProyectoFinal.Frontend.Util.ListaCircularDoble<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>

@{
    Layout = "_LayoutBuscador";
    ViewData["Title"] = "Principal";
    var listaLibros = Model?.ObtenerListaCompleta() ?? new List<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>();
}

<div class="container my-5 contenido-principal">
    @if (listaLibros.Count == 0)
    {
        <div class="text-center py-5 card shadow-sm p-5 border-0 rounded-4" style="background-color: var(--fondo-secundario);">
            <h2 class="display-6 fw-bold text-danger">Bienvenido a Xandria</h2>
            <p class="lead my-3 text-muted">No hay libros registrados en el sistema en este momento.</p>
            <div class="my-4">
                <span style="font-size: 5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.25));">📚</span>
            </div>
            <p class="text-secondary max-width-500 mx-auto">Por favor, registra algunos libros en el panel de administración para comenzar a disfrutar de la lectura.</p>
        </div>
    }
    else
    {
        <div class="carrusel-contenedor">
            <span class="carrusel-subtitulo">Libritos </span>
            
            <div class="carrusel-vista mt-4">
                <button class="carrusel-control anterior" id="btn-carrusel-prev" title="Anterior">
                    &lt;
                </button>
                
                <div class="carrusel-lista" id="carrusel-lista-libros">
                    @for (int indiceLibro = 0; indiceLibro < listaLibros.Count; indiceLibro++)
                    {
                        var libroItem = listaLibros[indiceLibro];
                        var fuenteImagen = "";
                        if (!string.IsNullOrEmpty(libroItem.Portada))
                        {
                            if (libroItem.Portada.StartsWith("http") || libroItem.Portada.StartsWith("/") || libroItem.Portada.StartsWith("~"))
                            {
                                fuenteImagen = libroItem.Portada;
                            }
                            else if (libroItem.Portada.Contains("base64,"))
                            {
                                fuenteImagen = libroItem.Portada;
                            }
                            else
                            {
                                fuenteImagen = "data:image/jpeg;base64," + libroItem.Portada;
                            }
                        }
                        else
                        {
                            fuenteImagen = "/images/Home-book.webp";
                        }

                        <div class="libro-item" 
                             data-index="@indiceLibro"
                             data-titulo="@libroItem.Titulo"
                             data-autor="@libroItem.Autor"
                             data-isbn="@libroItem.ISBN"
                             onclick="window.location.href='@Url.Action("DetallesLibro", "Home", new { isbn = libroItem.ISBN })'"
                             style="cursor: pointer;">
                            <img src="@fuenteImagen" alt="@libroItem.Titulo" onerror="this.src='/images/Home-book.webp';">
                        </div>
                    }
                </div>
                
                <button class="carrusel-control siguiente" id="btn-carrusel-next" title="Siguiente">
                    &gt;
                </button>
            </div>
            
            <div class="libro-info-panel">
                <div class="libro-info-titulo" id="carrusel-info-titulo"></div>
                <div class="libro-info-autor" id="carrusel-info-autor"></div>
                <div class="libro-info-isbn" id="carrusel-info-isbn"></div>
            </div>
        </div>
    }
</div>
