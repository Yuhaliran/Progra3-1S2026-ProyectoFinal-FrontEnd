@model Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse
@{
    ViewData["Title"] = Model.Titulo;
    var imageSrc = "";
    if (!string.IsNullOrEmpty(Model.Portada))
    {
        if (Model.Portada.StartsWith("http") || Model.Portada.StartsWith("/") || Model.Portada.StartsWith("~"))
        {
            imageSrc = Model.Portada;
        }
        else if (Model.Portada.Contains("base64,"))
        {
            imageSrc = Model.Portada;
        }
        else
        {
            imageSrc = "data:image/jpeg;base64," + Model.Portada;
        }
    }
    else
    {
        imageSrc = "/images/Home-book.webp";
    }

    var cola = ViewBag.ColaLectura as Progra3.ProyectoFinal.Frontend.Models.Response.Bitacora.ColaLecturaResponse;
    var estados = ViewBag.Estados as List<Progra3.ProyectoFinal.Frontend.Models.EstadoLectura>;
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-4 text-center mb-4 mb-md-0">
            <img src="@imageSrc" alt="@Model.Titulo" class="img-fluid rounded shadow" style="max-height: 500px; object-fit: cover;" onerror="this.src='/images/Home-book.webp';" />
        </div>
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: rgba(25, 135, 84, 0.1); border-color: rgba(25, 135, 84, 0.3); color: #198754;">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background-color: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.3); color: #dc3545;">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h1 class="display-4 fw-bold mb-3" style="color: var(--texto-primario);">@Model.Titulo</h1>
            <h3 class="text-muted mb-4">Por @Model.Autor</h3>
            <p><strong>ISBN:</strong> @Model.ISBN</p>
            <p><strong>Año de Publicación:</strong> @(Model.AnioPublicacion?.ToString() ?? "Desconocido")</p>

            <hr class="my-4" style="border-color: var(--borde-color);" />

            <h4 class="mb-4" style="color: var(--texto-primario);">Mi Bitácora de Lectura</h4>
            
            @if (estados != null && estados.Any())
            {
                <form asp-action="GuardarColaLectura" asp-controller="Home" method="post" class="card shadow-sm p-4" style="background-color: var(--fondo-secundario); border: 1px solid var(--borde-color); border-radius: 10px;">
                    <input type="hidden" name="ISBN" value="@Model.ISBN" />
                    
                    <div class="mb-3">
                        <label class="form-label" style="color: var(--texto-secundario);">Estado de Lectura</label>
                        <select name="IdEstadoLectura" class="form-select bg-dark text-light border-secondary" required>
                            <option value="">Seleccione un estado...</option>
                            @foreach(var estado in estados)
                            {
                                if (cola != null && cola.IdEstadoLectura == estado.IdEstadoLectura)
                                {
                                    <option value="@estado.IdEstadoLectura" selected>@estado.NombreEstado</option>
                                }
                                else
                                {
                                    <option value="@estado.IdEstadoLectura">@estado.NombreEstado</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--texto-secundario);">Fecha de Inicio</label>
                            <input type="date" name="FechaInicio" class="form-control bg-dark text-light border-secondary" value="@(cola?.FechaInicio?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--texto-secundario);">Fecha de Fin</label>
                            <input type="date" name="FechaFin" class="form-control bg-dark text-light border-secondary" value="@(cola?.FechaFin?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block" style="color: var(--texto-secundario);">¿Te gustó el libro?</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="MeGusto" id="meGustoSi" value="true" @(cola?.MeGusto == true ? "checked" : "")>
                            <label class="form-check-label text-light" for="meGustoSi">Sí</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="MeGusto" id="meGustoNo" value="false" @(cola?.MeGusto == false ? "checked" : "")>
                            <label class="form-check-label text-light" for="meGustoNo">No</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="MeGusto" id="meGustoNull" value="" @(cola?.MeGusto == null ? "checked" : "")>
                            <label class="form-check-label text-light" for="meGustoNull">Sin Opinión</label>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" style="background-color: var(--acento-primario); border-color: var(--acento-primario);">Guardar en Bitácora</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning" style="background-color: rgba(255, 193, 7, 0.1); border-color: rgba(255, 193, 7, 0.3); color: #ffca2c;">
                    Por favor <a href="@Url.Action("Login", "Auth")" class="alert-link text-warning">inicia sesión</a> para gestionar tu bitácora de lectura.
                </div>
            }

            <div class="mt-4">
                <a href="@Url.Action("Principal", "Home")" class="btn btn-outline-light">&larr; Volver a la colección</a>
            </div>
        </div>
    </div>
</div>
