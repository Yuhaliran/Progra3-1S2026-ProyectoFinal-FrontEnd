@model Progra3.ProyectoFinal.Frontend.Util.Pila<Progra3.ProyectoFinal.Frontend.Models.Response.Bitacora.ColaLecturaResponse>

@{
    ViewData["Title"] = "Mi Cola de Lectura";
    var librosCola = Model?.ObtenerListaCompleta() ?? new List<Progra3.ProyectoFinal.Frontend.Models.Response.Bitacora.ColaLecturaResponse>();
}

<div class="container my-5 contenido-principal">
    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h1 class="font-weight-bold" style="color: var(--texto-principal); font-weight: 800; font-size: 2.2rem;">
                Mi Cola de Lectura
            </h1>
            <p class="text-muted mb-0">
                Visualiza tu historial y colita de lectura.
            </p>
        </div>
    </div>

    @if (librosCola.Count == 0)
    {
        <div class="row justify-content-center py-5">
            <div class="col-md-8 text-center">
                <div class="card border-0 shadow-lg p-5 rounded-4" style="background-color: var(--fondo-secundario); border: 1px solid var(--color-borde) !important;">
                    <span style="font-size: 5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.25));" class="d-block mb-4">📖⏳</span>
                    <h3 class="font-weight-bold mb-2" style="color: var(--texto-principal);">Tu cola de lectura está vacía</h3>
                    <p class="text-muted mb-4 max-width-500 mx-auto">
                        No has agregado ningún libro a tu bitácora de lectura todavía. Explora el catálogo y añade obras para llevar el control.
                    </p>
                    <div>
                        <a asp-controller="Home" asp-action="Principal" class="btn btn-primary px-5 py-2.5" style="border-radius: 10px; font-weight: 600;">
                            Ver Obras Disponibles
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 16px; background-color: var(--fondo-secundario); border: 1px solid var(--color-borde) !important;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-white" style="border-collapse: collapse;">
                    <thead style="background-color: var(--fondo-terciario); color: var(--texto-secundario); border-bottom: 2px solid var(--color-borde);">
                        <tr>
                            <th scope="col" class="px-4 py-3 text-center" style="width: 70px;">Orden</th>
                            <th scope="col" class="px-3 py-3">Detalle del Libro</th>
                            <th scope="col" class="px-3 py-3">ISBN</th>
                            <th scope="col" class="px-3 py-3 text-center">Estado de Lectura</th>
                            <th scope="col" class="px-3 py-3 text-center">Fecha Inicio</th>
                            <th scope="col" class="px-3 py-3 text-center">Fecha Fin</th>
                            <th scope="col" class="px-3 py-3 text-center">Preferencia</th>
                            <th scope="col" class="px-3 py-3 text-center">Agregado el</th>
                            <th scope="col" class="px-4 py-3 text-center" style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody style="border-top: none;">
                        @for (int i = 0; i < librosCola.Count; i++)
                        {
                            var item = librosCola[i];
                            
                            var badgeStyle = "";
                            var icon = "";
                            switch (item.NombreEstado.ToLower())
                            {
                                case "leyendo":
                                    badgeStyle = "background-color: rgba(27, 110, 194, 0.15); color: #1b6ec2; border: 1px solid rgba(27, 110, 194, 0.3);";
                                    icon = "📖";
                                    break;
                                case "quiero leer":
                                    badgeStyle = "background-color: rgba(255, 193, 7, 0.15); color: #ffc107; border: 1px solid rgba(255, 193, 7, 0.3);";
                                    icon = "⭐";
                                    break;
                                case "abandonado":
                                    badgeStyle = "background-color: rgba(220, 53, 69, 0.15); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.3);";
                                    icon = "🛑";
                                    break;
                                default:
                                    badgeStyle = "background-color: rgba(40, 167, 69, 0.15); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.3);";
                                    icon = "✔️";
                                    break;
                            }

                            <tr style="border-bottom: 1px solid var(--color-borde); transition: background-color 0.2s;">                                
                                <td class="px-4 py-3 text-center font-weight-bold text-muted">
                                    <span class="badge rounded-circle px-2.5 py-1.5 shadow-sm" 
                                          style="background-color: var(--fondo-terciario); color: var(--texto-secundario); border: 1px solid var(--color-borde); font-size: 0.8rem;">
                                        @(librosCola.Count - i)
                                    </span>
                                </td>
                                
                                <td class="px-3 py-3">
                                    <div class="d-flex flex-column">
                                        <span class="font-weight-bold text-white mb-0" style="font-size: 0.95rem; font-weight: 700;">@item.TituloLibro</span>
                                        <span class="text-muted small" style="font-size: 0.8rem; color: var(--texto-atenuado) !important;">Por @item.AutorLibro</span>
                                    </div>
                                </td>
                                
                                <td class="px-3 py-3 font-monospace small" style="color: var(--texto-secundario);">
                                    @item.ISBN
                                </td>
                                
                                <td class="px-3 py-3 text-center">
                                    <span class="badge px-3 py-2 text-uppercase shadow-sm" style="@badgeStyle border-radius: 20px; font-size: 0.72rem; font-weight: 700;">
                                        @icon @item.NombreEstado
                                    </span>
                                </td>
                                
                                <td class="px-3 py-3 text-center small text-muted">
                                    @(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")
                                </td>
                                
                                <td class="px-3 py-3 text-center small text-muted">
                                    @(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("dd/MM/yyyy") : "-")
                                </td>
                                
                                <td class="px-3 py-3 text-center">
                                    @if (item.MeGusto.HasValue)
                                    {
                                        if (item.MeGusto.Value)
                                        {
                                            <span class="badge px-2.5 py-1.5 shadow-sm" style="background-color: rgba(40, 167, 69, 0.15); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.3); border-radius: 30px; font-size: 0.75rem;">
                                                Sí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge px-2.5 py-1.5 shadow-sm" style="background-color: rgba(220, 53, 69, 0.15); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.3); border-radius: 30px; font-size: 0.75rem;">
                                                No
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td class="px-3 py-3 text-center small text-muted" style="font-size: 0.8rem;">
                                    @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                
                                <td class="px-4 py-3 text-center">
                                    <a asp-controller="Home" asp-action="DetallesLibro" asp-route-isbn="@item.ISBN" 
                                       class="btn btn-outline-primary btn-sm px-3 shadow-sm" 
                                       style="border-radius: 8px; font-weight: 600; font-size: 0.8rem; border-color: var(--acento-principal); color: var(--texto-principal); background-color: transparent; transition: all 0.2s;">
                                        Detalles
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 d-flex align-items-center gap-3 bg-dark p-3 rounded-4 shadow-sm" style="background-color: var(--fondo-terciario) !important; border: 1px solid var(--color-borde);">
            <span style="font-size: 1.5rem;">🥞</span>            
        </div>
    }
</div>

<style>
    tr:hover {
        background-color: var(--fondo-terciario) !important;
    }
    .table th {
        font-weight: 700;
        letter-spacing: 0.5px;
    }
</style>
