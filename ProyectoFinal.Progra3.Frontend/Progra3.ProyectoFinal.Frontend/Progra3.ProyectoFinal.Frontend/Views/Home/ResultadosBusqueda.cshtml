@model IEnumerable<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>

@{
    Layout = "_LayoutBuscador";
    ViewData["Title"] = "Resultados de Búsqueda";
    var terminoBusqueda = ViewBag.Query as string ?? "";
    var listaResultados = Model?.ToList() ?? new List<Progra3.ProyectoFinal.Frontend.Models.Response.Libros.LibroResponse>();
}

<div class="container my-5 contenido-principal">
    <div class="row mb-5">
        <div class="col-12">
            <h1 class="font-weight-bold" style="color: var(--texto-principal); font-weight: 800; font-size: 2.2rem;">
                Resultados de Búsqueda
            </h1>
            <p class="text-muted">
                Mostrando resultados para: <span class="badge px-3 py-2 text-uppercase" style="background-color: var(--fondo-terciario); color: var(--acento-hover); border: 1px solid var(--color-borde); font-size: 0.9rem; border-radius: 20px;">"@terminoBusqueda"</span>
            </p>
        </div>
    </div>

    @if (listaResultados.Count == 0)
    {
        <div class="row justify-content-center py-5">
            <div class="col-md-8 text-center">
                <div class="card border-0 shadow-lg p-5 rounded-4" style="background-color: var(--fondo-secundario); border: 1px solid var(--color-borde) !important;">
                    <span style="font-size: 5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));" class="d-block mb-4">🔍❌</span>
                    <h3 class="font-weight-bold text-danger mb-2">No se encontraron libros</h3>
                    <p class="text-muted mb-4 max-width-500 mx-auto">
                        No pudimos encontrar ninguna coincidencia para <strong style="color: var(--texto-principal);">"@terminoBusqueda"</strong> en nuestro sistema local ni en repositorios externos unificados por ISBN.
                    </p>
                    
                    <div class="border-top pt-4 text-start max-width-500 mx-auto">
                        <h6 class="text-uppercase small mb-3" style="color: var(--acento-hover); font-weight: 700; letter-spacing: 1px;">Sugerencias de búsqueda:</h6>
                        <ul class="text-muted small ps-3 mb-0" style="line-height: 1.6;">
                            <li>Verifica que el título o autor esté escrito correctamente.</li>
                            <li>Si buscas por ISBN, asegúrate de ingresar un código de 10 o 13 dígitos exacto (ej. <em>9780140328721</em>).</li>
                            <li>Las búsquedas por texto libre (título o autor) solo se realizan de forma local en la base de datos de Xandria.</li>
                        </ul>
                    </div>
                    
                    <div class="mt-4">
                        <a asp-action="Principal" class="btn btn-outline-secondary px-4 py-2" 
                           style="border-radius: 10px; border: 1px solid var(--color-borde); color: var(--texto-principal); background-color: transparent;">
                            Volver al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var libroItem in listaResultados)
            {
                var fuenteImagen = "";
                if (!string.IsNullOrEmpty(libroItem.Portada))
                {
                    if (libroItem.Portada.StartsWith("http") || libroItem.Portada.StartsWith("/") || libroItem.Portada.StartsWith("~"))
                    {
                        fuenteImagen = libroItem.Portada;
                    }
                    else if (libroItem.Portada.Contains("base64,"))
                    {
                        fuenteImagen = libroItem.Portada;
                    }
                    else
                    {
                        fuenteImagen = "data:image/jpeg;base64," + libroItem.Portada;
                    }
                }
                else
                {
                    fuenteImagen = "/images/Home-book.webp";
                }

                <div class="col">
                    <div class="card h-100 border-0 shadow-lg overflow-hidden libro-card-busqueda" 
                         style="border-radius: 16px; transition: transform 0.3s ease, box-shadow 0.3s ease; background-color: var(--fondo-secundario);">
                        
                        <div class="position-relative overflow-hidden bg-dark" style="height: 280px;">
                            <img src="@fuenteImagen" class="card-img-top w-100 h-100" alt="@libroItem.Titulo" 
                                 style="object-fit: cover; transition: transform 0.4s ease;"
                                 onerror="this.src='/images/Home-book.webp';">
                            
                            <span class="position-absolute top-3 start-3 badge text-uppercase py-1.5 px-2.5 shadow-sm" 
                                  style="top: 15px; left: 15px; background-color: rgba(20, 18, 16, 0.85); color: var(--texto-secundario); border: 1px solid var(--color-borde); border-radius: 8px; font-size: 0.75rem; font-weight: 600;">
                                🔢 @libroItem.ISBN
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title text-truncate-2 font-weight-bold mb-1" 
                                style="color: var(--texto-principal); font-size: 1.15rem; font-weight: 700; min-height: 48px; line-height: 1.4;" 
                                title="@libroItem.Titulo">
                                @libroItem.Titulo
                            </h5>
                            
                            <p class="card-text text-truncate text-muted mb-3 small" style="color: var(--texto-secundario) !important;">
                                👤 @libroItem.Autor
                            </p>
                            
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top" style="border-top-color: var(--color-borde) !important;">
                                <span class="small text-muted">
                                    📅 @(libroItem.AnioPublicacion.HasValue && libroItem.AnioPublicacion.Value > 0 ? libroItem.AnioPublicacion.Value.ToString() : "N/A")
                                </span>
                                
                                <a asp-action="DetallesLibro" asp-route-isbn="@libroItem.ISBN" class="btn btn-primary btn-sm px-3 py-1.5" 
                                   style="border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-5">
            <a asp-action="Principal" class="btn btn-outline-secondary px-5 py-2.5" 
               style="border-radius: 10px; border: 1px solid var(--color-borde); color: var(--texto-principal); background-color: transparent;">
                Volver a la Página Principal
            </a>
        </div>
    }
</div>

<style>
    .libro-card-busqueda:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45) !important;
    }
    .libro-card-busqueda:hover img {
        transform: scale(1.06);
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
