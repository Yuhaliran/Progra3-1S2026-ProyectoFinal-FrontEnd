<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Progra3.ProyectoFinal.Frontend</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Progra3.ProyectoFinal.Frontend.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Progra3.ProyectoFinal.Frontend</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container text-md-left">
            <div class="row text-md-left">

                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3 footer-section">
                    <h5 class="text-uppercase mb-4 fw-bold small-title">Sobre Nosotros</h5>
                    <p class="text-muted footer-text">
                        En la tienda en línea de Xandria encuentra una selección de títulos para todos los gustos y todos los momentos.
                    </p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-center d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">f</a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-center d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">t</a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-center d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">i</a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-center d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">in</a>
                    </div>
                </div>

                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3 footer-section">
                    <h5 class="text-uppercase mb-4 fw-bold small-title">Servicios</h5>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Explorar Libros</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Recomendaciones</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Novedades</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Biblioteca Digital</a></p>
                </div>

                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3 footer-section">
                    <h5 class="text-uppercase mb-4 fw-bold small-title">Mi Cuenta</h5>
                    <p><a asp-controller="Home" asp-action="ModificarUsuario" class="text-muted text-decoration-none footer-link">Ingresar / Registrarse</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Mis Libros Prestados</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Historial de Préstamos</a></p>
                    <p><a href="#" class="text-muted text-decoration-none footer-link">Membresía</a></p>
                </div>

                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3 footer-section">
                    <h5 class="text-uppercase mb-4 fw-bold small-title">Contacto</h5>
                    <p class="text-muted footer-text">
                        ✉️ info@xandria.com.gt
                    </p>
                    <p class="text-muted footer-text">
                        📞 +502 2200-0000
                    </p>
                    <p class="text-muted footer-text">
                        🏠 Ciudad de Guatemala, Guatemala
                    </p>
                </div>

            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
