<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Progra3.ProyectoFinal.Frontend</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Progra3.ProyectoFinal.Frontend.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white py-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-dark" asp-area="" asp-controller="Home" asp-action="Principal">BookStore</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarXandria" aria-controls="navbarXandria" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarXandria">
                
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold text-uppercase small" asp-area="" asp-controller="Home" asp-action="Principal">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold text-uppercase small" href="#">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold text-uppercase small" href="#">Books</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold text-uppercase small" href="#">Pages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold text-uppercase small" href="#">Blog</a>
                    </li>
                </ul>

                <div class="d-flex">
                    <a href="#" class="btn btn-dark px-4 py-2 fw-bold text-uppercase rounded-0 small btn-download">Download APP</a>
                </div>

            </div>
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Progra3.ProyectoFinal.Frontend - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
